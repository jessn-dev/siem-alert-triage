# Copy to .env.secrets (gitignored) and replace with a real value before deploying.
#   cp .env.secrets.example .env.secrets
#   openssl rand -hex 32   # generate a token
#
# Shared by the engine (validates inbound events) and the generator (signs them).
# If they diverge the engine returns 401 and the producer logs a delivery failure.
SIEM_INGEST_TOKEN=change-me
